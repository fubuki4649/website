---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h3>
				👋🏽
			</h3>
			<div>
				<h4 style="display:inline">Hey there,</h4>
				&nbsp;
				<h3 style="display:inline">My name is Frank Tao!</h3>
			</div>
			<p>
				I'm a Computer Science student at the University of Waterloo that likes to build things in
				<code>kotlin</code>, <code>typescript</code>, and <code>rust</code>, as well exploring whatever new things that happen to catch my interest.
			</p>
			<p>
				I'm also looking for internships! Here is
				<a href="https://franktao.com/files/resume.pdf" target="_blank" style="text-decoration:none;color:#2c84db">
					my résumé</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
